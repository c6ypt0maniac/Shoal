# Copy to .env and fill in. .env is gitignored.

# Where people reach Shoal, no trailing slash: the website's URL when it
# forwards /api/* here. GitHub sign-in and Stripe return here; register
# <SHOAL_PUBLIC_URL>/api/auth/github/callback on the GitHub OAuth App.
# Unset: the host each request came through.
# SHOAL_PUBLIC_URL=https://shoal.example

# Other website origin(s) that call the API directly from the browser, comma
# separated. Not needed when the site forwards /api/* here (web/middleware.js
# on Vercel): that's the same origin. Unset: no other origin may call the API.
# SHOAL_WEB_ORIGINS=https://shoal.example,https://www.shoal.example

# Sign in with GitHub: create an OAuth App at github.com/settings/developers
# Callback URL: <SHOAL_PUBLIC_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Encrypts what Shoal stores that must stay secret: sign-in sessions' GitHub
# tokens and builder webhook secrets. Required once deployed (nobody can sign
# in without it). Changing it signs everyone out. Generate: openssl rand -hex 32
SHOAL_AUTH_SECRET=

# Optional: Stripe escrow. Without it, escrow is simulated.
# Test keys (sk_test_, dashboard.stripe.com/test/apikeys) work as is.
# Live keys (sk_live_) charge REAL cards: they also need STRIPE_ALLOW_LIVE=1
# and SHOAL_MOCK must not be 1.
STRIPE_SECRET_KEY=
# STRIPE_ALLOW_LIVE=1
# Webhook signing secret (whsec_), so a payment is recorded even if the browser
# never returns from Stripe. Locally: stripe listen --forward-to localhost:4000/api/stripe/webhook
# Hosted: Developers -> Webhooks -> <SHOAL_PUBLIC_URL>/api/stripe/webhook, event checkout.session.completed.
# STRIPE_WEBHOOK_SECRET=

# Model API keys (Anthropic, OpenAI, OpenRouter) are NOT set here: the server
# never reads them from the environment. Each user adds their own on the
# website's API keys page; they're sent with each request (src/user-keys.js).
# A request without any is in practice mode (bundled demo repo only).

# Marketplace agents' model: Claude when the user added an Anthropic key, otherwise OpenAI.
# SHOAL_MODEL=claude-opus-5-5
# SHOAL_OPENAI_MODEL=gpt-6.1-sol

# Most the team's keys spend on one bug's trials and proof, in dollars, flat.
# Default: 5% of a week of the test's dev time (hours x $50), between $2 and $10.
# SHOAL_TRIAL_CAP=2

# Behind a proxy other than Vercel (nginx, Render, Fly...): trust X-Forwarded-*.
# SHOAL_TRUST_PROXY=1

# Supabase (Shoal's database: bounties, ledger, scorecards, marketplace).
# Only the Postgres connection string is used. Each user's rows carry their
# GitHub login (owner); sessions live in the sessions table. Postgres connection string, used to create Shoal's tables at startup:
# Project Settings -> Database -> Connection string -> URI. On Vercel use
# the pooler URI (port 6543).
SUPABASE_DB_URL=


# Data saved before Shoal had separate users (one shared workspace) goes to
# this GitHub login on the first start. Unset: the local user's, which only a
# local server uses.
# SHOAL_LEGACY_OWNER=your-github-login
