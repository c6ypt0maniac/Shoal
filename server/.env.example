# Copy to .env and fill in. .env is gitignored.

# Sign in with GitHub: create an OAuth App at github.com/settings/developers
# Callback URL: http://localhost:4000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: Stripe escrow. Without it, escrow is simulated.
# Test keys (sk_test_, dashboard.stripe.com/test/apikeys) work as is.
# Live keys (sk_live_) charge REAL cards: they also need STRIPE_ALLOW_LIVE=1
# and real Claude agents (ANTHROPIC_API_KEY set).
STRIPE_SECRET_KEY=
# STRIPE_ALLOW_LIVE=1

# Optional: real Claude agents instead of mock ones
# ANTHROPIC_API_KEY=

# One-time app setup. After this, every user connects from the Team dashboard
# by signing in and approving access; Shoal stores their authorization privately.
# Jira callback: http://localhost:4000/api/auth/jira/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# GitLab callback: http://localhost:4000/api/auth/gitlab/callback
GITLAB_URL=https://gitlab.com
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
