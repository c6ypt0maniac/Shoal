# Copy to .env and fill in. .env is gitignored.

# Where this server is reachable from outside, no trailing slash. OAuth
# redirects are built from it. Defaults to
# http://localhost:4000 (on Vercel: the project's production domain).
# SHOAL_PUBLIC_URL=https://api.shoal.example

# The website's origin(s), when it's hosted separately, comma separated.
# Those origins may call the API from the browser and be returned to after
# GitHub sign-in. Unset: any origin may call the API (fine for local dev only).
# SHOAL_WEB_ORIGINS=https://shoal.example,https://www.shoal.example

# Sign in with GitHub: create an OAuth App at github.com/settings/developers
# Callback URL: <SHOAL_PUBLIC_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Encrypts the secrets Shoal stores (builder webhook secrets). Required to
# publish webhook agents. Generate: openssl rand -hex 32
SHOAL_AUTH_SECRET=

# Optional: Stripe escrow. Without it, escrow is simulated.
# Test keys (sk_test_, dashboard.stripe.com/test/apikeys) work as is.
# Live keys (sk_live_) charge REAL cards: they also need STRIPE_ALLOW_LIVE=1
# and real agents (ANTHROPIC_API_KEY or OPENAI_API_KEY set).
STRIPE_SECRET_KEY=
# STRIPE_ALLOW_LIVE=1
# Webhook signing secret (whsec_), so a payment is recorded even if the browser
# never returns from Stripe. Locally: stripe listen --forward-to localhost:4000/api/stripe/webhook
# Hosted: Developers -> Webhooks -> <SHOAL_PUBLIC_URL>/api/stripe/webhook, event checkout.session.completed.
# STRIPE_WEBHOOK_SECRET=

# Shoal's own keys: trials (diagnoses and fixes), the challenge-test writer,
# the judges and bounty races all run on them. Without either key the server
# is in practice mode, which only works on the bundled demo repo.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Marketplace agents' model: Claude when ANTHROPIC_API_KEY is set, otherwise OpenAI.
# SHOAL_MODEL=claude-opus-5-5
# SHOAL_OPENAI_MODEL=gpt-6.1-sol

# Most Shoal spends on one bug's trials and proof, in dollars (default 2).
# SHOAL_TRIAL_CAP=2

# Behind a proxy other than Vercel (nginx, Render, Fly...): trust X-Forwarded-*.
# SHOAL_TRUST_PROXY=1

# Supabase (Shoal's database: bounties, ledger, scorecards, marketplace).
# Project URL and service_role key (server only, never in the browser):
# Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, used to create Shoal's tables at startup:
# Project Settings -> Database -> Connection string -> URI. On Vercel use
# the pooler URI (port 6543).
SUPABASE_DB_URL=

# OpenRouter, for marketplace models imported from it to compete on bounties.
# openrouter.ai -> Keys. Listing a model doesn't need it.
# OPENROUTER_API_KEY=
