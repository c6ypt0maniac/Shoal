# Copy to .env and fill in. .env is gitignored.

# Where this server is reachable from outside, no trailing slash. OAuth
# redirects and the MCP URL are built from it. Defaults to
# http://localhost:4000 (on Vercel: the project's production domain).
# SHOAL_PUBLIC_URL=https://api.shoal.example

# The website's origin(s), when it's hosted separately, comma separated.
# Those origins may call the API from the browser and be returned to after
# GitHub sign-in. Unset: any origin may call the API (fine for local dev only).
# SHOAL_WEB_ORIGINS=https://shoal.example,https://www.shoal.example

# Sign in with GitHub: create an OAuth App at github.com/settings/developers
# Callback URL: <SHOAL_PUBLIC_URL>/api/auth/github/callback
# (MCP sign-in uses .../callback/mcp, which GitHub accepts under the same app.)
# Setting these also turns on the hosted MCP: ChatGPT, Codex and Claude can
# connect to <SHOAL_PUBLIC_URL>/mcp and sign in with GitHub.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Encrypts MCP sign-ins (client registrations, codes, tokens). Required when
# hosted; without it, a random key is used and every MCP app has to sign in
# again after a restart. Generate: openssl rand -hex 32
SHOAL_AUTH_SECRET=

# Optional: Stripe escrow. Without it, escrow is simulated.
# Test keys (sk_test_, dashboard.stripe.com/test/apikeys) work as is.
# Live keys (sk_live_) charge REAL cards: they also need STRIPE_ALLOW_LIVE=1
# and real agents (ANTHROPIC_API_KEY or OPENAI_API_KEY set).
STRIPE_SECRET_KEY=
# STRIPE_ALLOW_LIVE=1

# Paid runs use Shoal's own keys; trials never do (they run on the team's own
# plan over MCP). Without either key, agents are mocked.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Marketplace agents' model: Claude when ANTHROPIC_API_KEY is set, otherwise OpenAI.
# SHOAL_MODEL=claude-opus-5-5
# SHOAL_OPENAI_MODEL=gpt-6.1-sol

# One-click trials use Claude Code and/or Codex signed in on this machine
# (free, on the team's own Claude / ChatGPT plans). Which OpenAI models Codex runs:
# SHOAL_CODEX_MODELS=gpt-6-luna,gpt-6-sol,gpt-6.1-sol,gpt-6-astra
# If the CLIs aren't on PATH:
# CLAUDE_BIN=/path/to/claude
# CODEX_BIN=/path/to/codex

# Behind a proxy other than Vercel (nginx, Render, Fly...): trust X-Forwarded-*.
# SHOAL_TRUST_PROXY=1
