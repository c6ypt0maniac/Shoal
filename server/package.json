{
  "name": "shoal-server",
  "private": true,
  "version": "0.1.0",
  "description": "Shoal backend: Pain Graph scanner, agent bounties, verifier and live event stream",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "demo": "node scripts/demo.js",
    "smoke:openai": "node --env-file-if-exists=.env scripts/openai-smoke.js",
    "check:mcp": "node scripts/mcp-oauth-check.js && node scripts/judges-check.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "openai": "^7.43.0",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  }
}
